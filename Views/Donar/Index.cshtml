@{
    ViewData["Title"] = "Donar";
    var nombre = ViewBag.UsuarioNombre as string ?? "Usuario";
    var apellido = ViewBag.UsuarioApellido as string ?? string.Empty;
    var email = ViewBag.UsuarioEmail as string ?? string.Empty;
    var organizaciones = ViewBag.Organizaciones as List<ProgramacionXEfsi_Puente.Models.Organizacion> ?? new List<ProgramacionXEfsi_Puente.Models.Organizacion>();
    var organizacionSeleccionada = ViewBag.OrganizacionSeleccionada as ProgramacionXEfsi_Puente.Models.Organizacion;
    var publicacion = ViewBag.Publicacion as ProgramacionXEfsi_Puente.Models.Publicacion;
    var idOrganizacion = (int)(ViewBag.OrganizacionId ?? 0);
    var idPublicacion = (int)(ViewBag.IdPublicacion ?? 0);

    var tipoAportePredeterminado = publicacion == null
        ? "Donación"
        : (publicacion.Necesidades.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).FirstOrDefault()
           ?? publicacion.TipoPropuesta
           ?? "Donación");
}

<div class="grid grid-cols-1 gap-12 py-12 md:grid-cols-2">
    <div class="space-y-6">
        <div>
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#6F625D]">Ayudá con tu aporte</p>
            <h1 class="mt-3 text-4xl font-black text-[#2F2A28] md:text-5xl">Cada donación cuenta</h1>
        </div>

        <p class="max-w-lg text-lg text-[#4A403B]">Completá el formulario y la organización se pondrá en contacto.</p>

        <div class="rounded-2xl bg-[#F2F0EE] p-6 shadow-sm ring-1 ring-[#E8E1DB]">
            @if (publicacion != null)
            {
                <p class="text-xs font-black uppercase tracking-[0.18em] text-[#6F625D]">Publicación seleccionada</p>
                <h2 class="mt-2 text-2xl font-bold text-[#2F2A28]">@publicacion.Titulo</h2>
                <p class="mt-1 font-semibold text-[#496C69]">@publicacion.NombreOrganizacion</p>
                <p class="mt-3 text-base leading-7 text-[#4A403B]">@publicacion.Descripcion</p>

                @if (!string.IsNullOrWhiteSpace(publicacion.Necesidades))
                {
                    <p class="mt-5 text-sm font-bold uppercase tracking-[0.18em] text-[#6F625D]">Necesidades</p>
                    <p class="mt-2 text-base text-[#3E3631]">@publicacion.Necesidades</p>
                }

                @if (!string.IsNullOrWhiteSpace(publicacion.CosasQueNecesitan))
                {
                    <p class="mt-5 text-sm font-bold uppercase tracking-[0.18em] text-[#6F625D]">Cosas que necesita</p>
                    <p class="mt-2 whitespace-pre-line text-base text-[#3E3631]">@publicacion.CosasQueNecesitan</p>
                }
            }
            else
            {
                <h2 class="text-2xl font-bold text-[#2F2A28]">@((organizacionSeleccionada?.Nombre) ?? "Organización")</h2>
            }

            <div class="mt-6">
                <p class="text-sm font-bold uppercase tracking-[0.18em] text-[#6F625D]">Ubicación</p>
                <p class="mt-2 text-base text-[#2F2A28]">@(publicacion?.Ubicacion ?? organizacionSeleccionada?.Direccion ?? "Sin ubicación")</p>
                @if (publicacion != null && (!string.IsNullOrWhiteSpace(publicacion.DireccionOrganizacion) || !string.IsNullOrWhiteSpace(publicacion.BarrioOrganizacion)))
                {
                    <p class="mt-1 text-sm text-[#4A403B]">
                        @publicacion.DireccionOrganizacion @publicacion.BarrioOrganizacion
                    </p>
                }
                <a href="/Mapa" class="mt-2 inline-block text-sm font-semibold text-[#2F2A28] underline underline-offset-4 hover:text-[#7A6050]">Ver en el mapa</a>
            </div>
        </div>
    </div>

    <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-[#E8E1DB] md:p-8">
        <h2 class="text-3xl font-black text-[#2F2A28]">Quiero colaborar</h2>

        @if (!string.IsNullOrWhiteSpace(email))
        {
            <div class="mt-4 rounded-xl bg-[#F5F7F6] p-3 text-sm text-[#3E3631]">
                <span class="font-semibold">Donando como:</span> @nombre @apellido
            </div>
        }

        @if (TempData["DonacionError"] != null)
        {
            <div class="mt-4 rounded-xl border border-red-200 bg-red-50 p-3 text-sm font-semibold text-red-700">
                @TempData["DonacionError"]
            </div>
        }

        <form asp-action="Submit" asp-controller="Donar" method="post" class="mt-6 space-y-5">
            @Html.AntiForgeryToken()

            <input type="hidden" name="idOrganizacion" value="@idOrganizacion" />
            <input type="hidden" name="idPublicacion" value="@idPublicacion" />

            @if (publicacion != null)
            {
                <div class="grid gap-5 md:grid-cols-2">
                    <div>
                        <label for="idNecesidad" class="mb-2 block text-xs font-bold tracking-[0.18em] text-[#4A403B]">NECESIDAD A DONAR</label>
                        <select id="idNecesidad" name="idNecesidad" class="w-full rounded-xl border border-[#D9D1CA] bg-[#F9F7F5] px-4 py-3 text-sm text-[#2F2A28] outline-none transition focus:border-[#2F9D9D] focus:ring-2 focus:ring-[#CFEAEA]" required>
                            <option value="">Seleccioná una necesidad</option>
                            @foreach (var necesidad in publicacion.NecesidadesDetalle.Where(x => x.Restante > 0))
                            {
                                <option value="@necesidad.IdNecesidad" data-restante="@necesidad.Restante">@necesidad.Categoria — faltan @necesidad.Restante</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label for="cantidadNumerica" class="mb-2 block text-xs font-bold tracking-[0.18em] text-[#4A403B]">CANTIDAD</label>
                        <input id="cantidadNumerica" name="cantidadNumerica" type="number" min="1" step="1" value="1" class="w-full rounded-xl border border-[#D9D1CA] bg-[#F9F7F5] px-4 py-3 text-sm text-[#2F2A28] outline-none transition focus:border-[#2F9D9D] focus:ring-2 focus:ring-[#CFEAEA]" required />
                        <p id="restanteAyuda" class="mt-2 text-xs font-semibold text-[#7A6050]"></p>
                    </div>
                </div>
                <input type="hidden" name="tipoAporte" value="@tipoAportePredeterminado" />
                <input type="hidden" name="cantidad" value="" />
            }
            else
            {
                <div class="grid gap-5 md:grid-cols-2">
                    <div>
                        <label for="tipoAporte" class="mb-2 block text-xs font-bold tracking-[0.18em] text-[#4A403B]">TIPO DE APORTE</label>
                        <select id="tipoAporte" name="tipoAporte" class="w-full rounded-xl border border-[#D9D1CA] bg-[#F9F7F5] px-4 py-3 text-sm text-[#2F2A28] outline-none transition focus:border-[#2F9D9D] focus:ring-2 focus:ring-[#CFEAEA]">
                            <option value="Donación">Donación</option><option value="Dinero">Dinero</option><option value="Ropa">Ropa</option><option value="Alimentos">Alimentos</option><option value="Útiles">Útiles</option>
                        </select>
                    </div>
                    <div>
                        <label for="cantidad" class="mb-2 block text-xs font-bold tracking-[0.18em] text-[#4A403B]">CANTIDAD / DETALLE</label>
                        <input id="cantidad" name="cantidad" type="text" placeholder="$ 500 o 10 kilos" class="w-full rounded-xl border border-[#D9D1CA] bg-[#F9F7F5] px-4 py-3 text-sm text-[#2F2A28] outline-none transition focus:border-[#2F9D9D] focus:ring-2 focus:ring-[#CFEAEA]" required />
                    </div>
                </div>
            }

            <div>
                <label for="mensaje" class="mb-2 block text-xs font-bold tracking-[0.18em] text-[#4A403B]">MENSAJE</label>
                <textarea id="mensaje" name="mensaje" rows="5" class="w-full rounded-xl border border-[#D9D1CA] bg-[#F9F7F5] px-4 py-3 text-sm text-[#2F2A28] outline-none transition focus:border-[#2F9D9D] focus:ring-2 focus:ring-[#CFEAEA]" placeholder="Dejanos un mensaje para la ONG"></textarea>
            </div>

            <div class="flex items-center gap-3 rounded-xl bg-[#F6F3F1] p-3">
                <input id="donarAnonimamente" name="donarAnonimamente" type="checkbox" value="true" class="h-4 w-4 rounded border-[#D9D1CA] text-[#2F9D9D] focus:ring-[#CFEAEA]" />
                <label for="donarAnonimamente" class="text-sm font-medium text-[#2F2A28]">Donar anónimamente</label>
            </div>

            <div id="mensajeAnonimo" class="hidden rounded-xl border border-dashed border-[#D9D1CA] bg-[#F9F7F5] px-3 py-2 text-sm text-[#4A403B]">
                Estás donando como anónimo.
            </div>

            <button type="submit" class="w-full rounded-xl bg-[#2F2A28] px-4 py-3.5 text-base font-bold text-white transition hover:bg-[#1d1b1a]">
                Enviar propuesta de donación
            </button>
        </form>
    </div>
</div>

<script>
    const checkboxAnonimo = document.getElementById('donarAnonimamente');
    const mensajeAnonimo = document.getElementById('mensajeAnonimo');

    checkboxAnonimo.addEventListener('change', function () {
        mensajeAnonimo.classList.toggle('hidden', !checkboxAnonimo.checked);
    });

    const necesidadSelect = document.getElementById('idNecesidad');
    const cantidadInput = document.getElementById('cantidadNumerica');
    const restanteAyuda = document.getElementById('restanteAyuda');

    if (necesidadSelect && cantidadInput) {
        necesidadSelect.addEventListener('change', function () {
            const opcion = necesidadSelect.options[necesidadSelect.selectedIndex];
            const restante = parseInt(opcion?.dataset?.restante || '0', 10);
            cantidadInput.max = restante > 0 ? restante : '';
            cantidadInput.value = restante > 0 ? '1' : '';
            restanteAyuda.textContent = restante > 0 ? `Máximo disponible: ${restante}` : '';
        });
    }
</script>
