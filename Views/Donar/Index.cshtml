@{
    ViewData["Title"] = "Donar";
    var nombre = ViewBag.UsuarioNombre as string ?? "Usuario";
    var apellido = ViewBag.UsuarioApellido as string ?? string.Empty;
    var email = ViewBag.UsuarioEmail as string ?? string.Empty;
}

<div class="grid grid-cols-1 gap-12 py-12 md:grid-cols-2">
    <div class="space-y-6">
        <div>
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#6F625D]">Ayudá con tu aporte</p>
            <h1 class="mt-3 text-4xl font-black text-[#2F2A28] md:text-5xl">Cada donación cuenta</h1>
        </div>

        <p class="max-w-lg text-lg text-[#4A403B]">Completá el formulario y la organización se pondrá en contacto.</p>

        <div class="rounded-2xl bg-[#F2F0EE] p-6 shadow-sm ring-1 ring-[#E8E1DB]">
            <h2 class="text-2xl font-bold text-[#2F2A28]">Alimentos para todos</h2>
            <p class="mt-3 text-base leading-7 text-[#4A403B]">
                Recolección de alimentos no perecederos para familias con ingresos reducidos y centros comunitarios.
            </p>

            <ul class="mt-5 space-y-2 text-base text-[#3E3631]">
                <li class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-[#D98C48]"></span> Alimentos no perecederos</li>
                <li class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-[#D98C48]"></span> Útiles escolares</li>
            </ul>

            <div class="mt-6">
                <p class="text-sm font-bold uppercase tracking-[0.18em] text-[#6F625D]">Ubicación</p>
                <p class="mt-2 text-base text-[#2F2A28]">Morón / Provincia de Buenos Aires</p>
                <a href="/Mapa" class="mt-2 inline-block text-sm font-semibold text-[#2F2A28] underline underline-offset-4 hover:text-[#7A6050]">
                    Ver en el mapa
                </a>
            </div>
        </div>
    </div>

    <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-[#E8E1DB] md:p-8">
        <h2 class="text-3xl font-black text-[#2F2A28]">Quiero colaborar</h2>

        @if (!string.IsNullOrWhiteSpace(email))
        {
            <div class="mt-4 rounded-xl bg-[#F5F7F6] p-3 text-sm text-[#3E3631]">
                <span class="font-semibold">Donando como:</span> @nombre @apellido
            </div>
        }

        <form asp-action="Submit" asp-controller="Donar" method="post" class="mt-6 space-y-5">
            @Html.AntiForgeryToken()

            <div class="grid gap-5 md:grid-cols-2">
                <div>
                    <label for="tipoAporte" class="mb-2 block text-xs font-bold tracking-[0.18em] text-[#4A403B]">TIPO DE APORTE</label>
                    <select id="tipoAporte" name="tipoAporte" class="w-full rounded-xl border border-[#D9D1CA] bg-[#F9F7F5] px-4 py-3 text-sm text-[#2F2A28] outline-none transition focus:border-[#2F9D9D] focus:ring-2 focus:ring-[#CFEAEA]">
                        <option value="Donación">Donación</option>
                        <option value="Dinero">Dinero</option>
                        <option value="Ropa">Ropa</option>
                        <option value="Alimentos">Alimentos</option>
                        <option value="Útiles">Útiles</option>
                    </select>
                </div>

                <div>
                    <label for="cantidad" class="mb-2 block text-xs font-bold tracking-[0.18em] text-[#4A403B]">CANTIDAD / DETALLE</label>
                    <input id="cantidad" name="cantidad" type="text" placeholder="$ 500 o 10 kilos" class="w-full rounded-xl border border-[#D9D1CA] bg-[#F9F7F5] px-4 py-3 text-sm text-[#2F2A28] outline-none transition focus:border-[#2F9D9D] focus:ring-2 focus:ring-[#CFEAEA]" required />
                </div>
            </div>

            <div>
                <label for="mensaje" class="mb-2 block text-xs font-bold tracking-[0.18em] text-[#4A403B]">MENSAJE</label>
                <textarea id="mensaje" name="mensaje" rows="5" class="w-full rounded-xl border border-[#D9D1CA] bg-[#F9F7F5] px-4 py-3 text-sm text-[#2F2A28] outline-none transition focus:border-[#2F9D9D] focus:ring-2 focus:ring-[#CFEAEA]" placeholder="Dejanos un mensaje para la ONG"></textarea>
            </div>

            <div class="flex items-center gap-3 rounded-xl bg-[#F6F3F1] p-3">
                <input id="donarAnonimamente" name="donarAnonimamente" type="checkbox" value="true" class="h-4 w-4 rounded border-[#D9D1CA] text-[#2F9D9D] focus:ring-[#CFEAEA]" />
                <label for="donarAnonimamente" class="text-sm font-medium text-[#2F2A28]">Donar anónimamente</label>
            </div>

            <div id="mensajeAnonimo" class="hidden rounded-xl border border-dashed border-[#D9D1CA] bg-[#F9F7F5] px-3 py-2 text-sm text-[#4A403B]">
                Estás donando como anónimo.
            </div>

            <button type="submit" class="w-full rounded-xl bg-[#2F2A28] px-4 py-3.5 text-base font-bold text-white transition hover:bg-[#1d1b1a]">
                Enviar propuesta de donación
            </button>
        </form>
    </div>
</div>

<script>
    const checkboxAnonimo = document.getElementById('donarAnonimamente');
    const mensajeAnonimo = document.getElementById('mensajeAnonimo');

    checkboxAnonimo.addEventListener('change', function () {
        mensajeAnonimo.classList.toggle('hidden', !checkboxAnonimo.checked);
    });
</script>
