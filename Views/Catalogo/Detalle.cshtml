@model ProgramacionXEfsi_Puente.Models.Publicacion
@{
    ViewData["Title"] = Model?.Titulo ?? "Publicación";
    var titulo = Model?.Titulo ?? "Publicación";
    var nombreOrganizacion = Model?.NombreOrganizacion ?? "Organización";
    var tipoPropuesta = Model?.TipoPropuesta ?? "Publicación";
    var descripcion = Model?.Descripcion ?? "Sin descripción";
    var ubicacion = Model?.Ubicacion ?? "Sin ubicación";
    var necesidades = Model?.Necesidades ?? string.Empty;
    var cosasQueNecesitan = Model?.CosasQueNecesitan ?? string.Empty;
    var necesidadesList = string.IsNullOrWhiteSpace(necesidades)
        ? new List<string>()
        : necesidades.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
    var telefono = Model?.TelefonoOrganizacion ?? string.Empty;
    var direccion = Model?.DireccionOrganizacion ?? string.Empty;
    var barrio = Model?.BarrioOrganizacion ?? string.Empty;
    var rol = Context.Session.GetString("Rol") ?? string.Empty;
    var esUsuario = string.Equals(rol, "Usuario", StringComparison.OrdinalIgnoreCase);
    var esOng = string.Equals(rol, "Ong", StringComparison.OrdinalIgnoreCase);
}

<div class="mx-auto max-w-5xl py-8">
    <div class="mb-6">
        <a href="/Catalogo" class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-semibold text-[#3F322B] shadow-sm ring-1 ring-[#E9DED2] transition hover:bg-[#F8F5F2]">
            ← Volver al catálogo
        </a>
    </div>

    <div class="overflow-hidden rounded-[28px] bg-white shadow-[0_20px_55px_rgba(56,40,29,0.08)] ring-1 ring-[#F0E5DB]">
        <div class="grid gap-0 md:grid-cols-[1.1fr_1.5fr]">
            <div class="relative min-h-72 bg-gradient-to-br from-[#F7EDD8] via-[#F3E5D6] to-[#E8F2F0]">
                @if (!string.IsNullOrWhiteSpace(Model?.ImagenUrl))
                {
                    <img src="@Model.ImagenUrl" alt="@titulo" class="absolute inset-0 h-full w-full object-cover" />
                }
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
                <div class="absolute bottom-0 left-0 p-8 md:p-10 text-white">
                    <div class="mb-3 inline-flex rounded-full bg-white/90 px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#4A403B]">
                        @tipoPropuesta
                    </div>
                    <h1 class="text-3xl font-black md:text-4xl">@titulo</h1>
                    <p class="mt-3 font-semibold">@nombreOrganizacion</p>
                </div>
            </div>

            <div class="p-8 md:p-10">
                <div class="flex items-center justify-between gap-4">
                    <div>
                        <p class="text-xs font-black uppercase tracking-[0.18em] text-[#6F625D]">Detalles de la publicación</p>
                        <h2 class="mt-2 text-2xl font-black text-[#2F2A28]">Cómo podés ayudar</h2>
                    </div>
                    <span class="rounded-full bg-[#E8F6F5] px-3 py-1 text-xs font-bold uppercase tracking-[0.14em] text-[#266F6A]">
                        Activa
                    </span>
                </div>

                <p class="mt-6 text-base leading-7 text-[#4A403B]">@descripcion</p>

                <div class="mt-6 grid gap-4 sm:grid-cols-2">
                    <div class="rounded-2xl bg-[#F8F5F2] p-5 ring-1 ring-[#E6DDD4]">
                        <p class="text-xs font-black uppercase tracking-[0.18em] text-[#6F625D]">Ubicación</p>
                        <p class="mt-2 font-semibold text-[#2F2A28]">@ubicacion</p>
                    </div>
                    @if (Model?.FechaLimite.HasValue == true)
                    {
                        <div class="rounded-2xl bg-[#F8F5F2] p-5 ring-1 ring-[#E6DDD4]">
                            <p class="text-xs font-black uppercase tracking-[0.18em] text-[#6F625D]">Fecha límite</p>
                            <p class="mt-2 font-semibold text-[#2F2A28]">@Model.FechaLimite.Value.ToString("dd/MM/yyyy")</p>
                        </div>
                    }
                </div>

                <div class="mt-6">
                    <p class="text-xs font-black uppercase tracking-[0.18em] text-[#6F625D]">Necesidades seleccionadas</p>
                    @if (necesidadesList.Any())
                    {
                        <div class="mt-3 flex flex-wrap gap-2">
                            @foreach (var necesidad in necesidadesList)
                            {
                                <span class="rounded-full bg-[#E8F6F5] px-4 py-2 text-sm font-bold text-[#266F6A]">@necesidad</span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="mt-3 rounded-2xl bg-[#F8F5F2] p-4 text-sm text-[#524A45] ring-1 ring-[#E6DDD4]">No se indicaron necesidades específicas.</p>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(telefono) || !string.IsNullOrWhiteSpace(direccion) || !string.IsNullOrWhiteSpace(barrio))
                {
                    <div class="mt-6 rounded-2xl bg-[#F4F9F8] p-5 ring-1 ring-[#D9EDEB]">
                        <p class="text-sm font-black uppercase tracking-[0.18em] text-[#496C69]">Información de la organización</p>
                        @if (!string.IsNullOrWhiteSpace(telefono))
                        {
                            <p class="mt-2 text-sm text-[#2F2A28]">Teléfono: @telefono</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(direccion))
                        {
                            <p class="mt-1 text-sm text-[#2F2A28]">Dirección: @direccion</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(barrio))
                        {
                            <p class="mt-1 text-sm text-[#2F2A28]">Localidad: @barrio</p>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(cosasQueNecesitan))
                {
                    <div class="mt-6 rounded-2xl bg-[#FFF8E8] p-5 ring-1 ring-[#ECDDA9]">
                        <p class="text-xs font-black uppercase tracking-[0.18em] text-[#6F625D]">Cosas que se necesitan</p>
                        <p class="mt-2 whitespace-pre-line text-sm leading-6 text-[#2F2A28]">@cosasQueNecesitan</p>
                    </div>
                }

                @if (Model?.NecesidadesDetalle?.Any() == true)
                {
                    <div class="mt-6 rounded-2xl bg-[#F8F5F2] p-5 ring-1 ring-[#E6DDD4]">
                        <div class="flex items-center justify-between gap-4">
                            <p class="text-xs font-black uppercase tracking-[0.18em] text-[#6F625D]">Progreso general</p>
                            <p class="text-sm font-black text-[#2F2A28]">@Model.PorcentajeGeneral%</p>
                        </div>
                        <div class="mt-3 h-3 overflow-hidden rounded-full bg-[#E8DFD6]">
                            <div class="h-full rounded-full bg-[#62C2B9]" style="width: @Model.PorcentajeGeneral%"></div>
                        </div>
                        <div class="mt-5 space-y-4">
                            @foreach (var necesidad in Model.NecesidadesDetalle)
                            {
                                <div>
                                    <div class="flex items-center justify-between gap-3 text-sm">
                                        <span class="font-bold text-[#2F2A28]">@necesidad.Categoria</span>
                                        <span class="text-[#6F625D]">@necesidad.CantidadRecibida / @necesidad.CantidadSolicitada · @necesidad.Porcentaje%</span>
                                    </div>
                                    <div class="mt-2 h-2.5 overflow-hidden rounded-full bg-[#E8DFD6]">
                                        <div class="h-full rounded-full bg-[#FF7341]" style="width: @necesidad.Porcentaje%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                    @if (esUsuario)
                    {
                        <a href="/Donar?IdOrganizacion=@Model.IdOrganizacion&IdPublicacion=@Model.Id" class="inline-flex flex-1 items-center justify-center rounded-2xl bg-[#FF7341] px-5 py-3 text-base font-black text-white shadow-sm transition hover:bg-[#EA6235]">
                            Donar
                        </a>
                    }
                    else if (esOng)
                    {
                        <div class="inline-flex flex-1 items-center justify-center rounded-2xl bg-[#E9F1F0] px-5 py-3 text-sm font-bold text-[#496C69]">
                            Las organizaciones pueden ver esta publicación, pero no realizar donaciones.
                        </div>
                    }
                    <a href="/Mapa" class="inline-flex flex-1 items-center justify-center rounded-2xl bg-[#F4E8DD] px-5 py-3 text-base font-black text-[#3F322B] transition hover:bg-[#EEDCC7]">
                        Ver en mapa
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
