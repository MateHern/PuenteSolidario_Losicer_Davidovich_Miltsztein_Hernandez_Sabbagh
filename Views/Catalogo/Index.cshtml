@{
    ViewData["Title"] = "Catálogo";

    var cards = new[]
    {
        new { Rubro = "DONACIONES", Titulo = "Alimentos para todos", Texto = "Recolección de alimentos no perecederos." },
        new { Rubro = "VOLUNTARIADO", Titulo = "Acompañar y aprender", Texto = "Voluntariado educativo para chicos." },
        new { Rubro = "INFRAESTRUCTURA", Titulo = "Un espacio para crecer", Texto = "Mejoras para un centro comunitario." },
        new { Rubro = "DONACIONES", Titulo = "Abrigo en invierno", Texto = "Ropa y mantas para quienes lo necesitan." },
        new { Rubro = "SALUD", Titulo = "Salud cerca tuyo", Texto = "Campaña de prevención de enfermedades." },
        new { Rubro = "ANIMALES", Titulo = "Red de apoyo animal", Texto = "Colaborá con refugios locales." }
    };
}

<div class="space-y-8 py-10">
    <div class="space-y-3">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#6F625D]">EXPLORÁ OPORTUNIDADES</p>
        <h1 class="text-4xl font-black text-[#2F2A28] md:text-5xl">Encontrá una organización que te necesite</h1>
        <p class="max-w-2xl text-lg text-[#4A403B]">Filtrá por tipo de ayuda, ubicación o grupo de personas.</p>
    </div>

    <div class="rounded-2xl border border-[#E8E1DB] bg-white p-3 shadow-sm">
        <div class="flex flex-col gap-0 md:flex-row md:items-center">
            <div class="flex-1 border-b border-[#E8E1DB] px-3 py-3 md:border-b-0 md:border-r md:px-4">
                <input type="text" placeholder="Buscar una causa..." class="w-full border-0 bg-transparent text-sm text-[#2F2A28] placeholder:text-[#867B76] focus:outline-none" />
            </div>

            <div class="flex-1 border-b border-[#E8E1DB] px-3 py-3 md:border-b-0 md:border-r md:px-4">
                <select class="w-full appearance-none border-0 bg-transparent text-sm text-[#2F2A28] focus:outline-none">
                    <option>Todas las categorías</option>
                    <option>Donaciones</option>
                    <option>Voluntariado</option>
                    <option>Salud</option>
                    <option>Infraestructura</option>
                    <option>Animales</option>
                </select>
            </div>

            <div class="flex-1 border-b border-[#E8E1DB] px-3 py-3 md:border-b-0 md:border-r md:px-4">
                <select class="w-full appearance-none border-0 bg-transparent text-sm text-[#2F2A28] focus:outline-none">
                    <option>Ubicación</option>
                    <option>Buenos Aires</option>
                    <option>Córdoba</option>
                    <option>Rosario</option>
                    <option>Santa Fe</option>
                </select>
            </div>

            <div class="px-3 py-3 md:px-4">
                <button type="button" class="rounded-xl bg-[#E9E3DE] px-5 py-2.5 text-sm font-semibold text-[#2F2A28] transition hover:bg-[#DDD1C8]">
                    Aplicar filtros
                </button>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        @foreach (var card in cards)
        {
            <article class="overflow-hidden rounded-2xl border border-[#E7E2DE] bg-[#F2F2F2] p-4 shadow-sm">
                <div class="relative mb-4 h-40 rounded-xl bg-[#E5E5E5]">
                    <span class="absolute left-3 top-3 rounded-full bg-white px-2.5 py-1 text-[10px] font-bold tracking-[0.18em] text-[#3E3631] shadow-sm">
                        @card.Rubro
                    </span>
                </div>

                <h3 class="text-2xl font-bold text-[#2F2A28]">@card.Titulo</h3>
                <p class="mt-3 text-base leading-7 text-[#4A403B]">@card.Texto</p>

                <a href="/Donar" class="mt-5 inline-flex items-center text-base font-semibold text-[#3E3631] transition hover:text-[#7A6050]">
                    Conocer más -&gt;
                </a>
            </article>
        }
    </div>
</div>
