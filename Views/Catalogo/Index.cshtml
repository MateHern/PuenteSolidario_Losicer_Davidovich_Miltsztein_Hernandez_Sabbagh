@model List<ProgramacionXEfsi_Puente.Models.Publicacion>
@{
    ViewData["Title"] = "Catálogo";
    var categorias = ViewBag.Categorias as List<string> ?? new List<string>();
    var provincias = ViewBag.Provincias as List<string> ?? new List<string>();
    var categoriaSeleccionada = ViewBag.CategoriaSeleccionada as string ?? string.Empty;
    var ubicacionSeleccionada = ViewBag.UbicacionSeleccionada as string ?? string.Empty;
}

<div class="catalog-page app-shell">
    @if (TempData["OkPublicacion"] != null)
    {
        <div class="mx-4 mt-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-700 md:mx-6">
            @TempData["OkPublicacion"]
        </div>
    }

    <section class="catalog-hero px-4 md:px-6">
        <div class="catalog-title">Encontrá publicaciones de organizaciones</div>
        <p class="catalog-subtitle">Filtrá por tipo de ayuda, ubicación o lo que estés buscando</p>

        <form method="get" asp-controller="Catalogo" asp-action="Index" class="catalog-filters">
            <input type="text" name="busqueda" value="@ViewBag.Busqueda" placeholder="Buscar una causa..." class="filter-field" />

            <select name="categoria" class="filter-field">
                <option value="">Todas las categorías</option>
                @foreach (var categoria in categorias)
                {
                    <option value="@categoria" selected="@(categoria == categoriaSeleccionada ? "selected" : null)">@categoria</option>
                }
            </select>

            <select name="ubicacion" class="filter-field">
                <option value="">Todas las provincias</option>
                @foreach (var provincia in provincias)
                {
                    <option value="@provincia" selected="@(provincia == ubicacionSeleccionada ? "selected" : null)">@provincia</option>
                }
            </select>

            <button type="submit" class="catalog-btn">Aplicar filtros</button>
        </form>
    </section>

    <section class="catalog-grid px-4 md:px-6">
        @if (Model != null && Model.Any())
        {
            @foreach (var publicacion in Model)
            {
                var tone = (publicacion.Titulo?.Length ?? 0) % 6;
                var variant = tone switch
                {
                    0 => "catalog-card--orange",
                    1 => "catalog-card--yellow",
                    2 => "catalog-card--mint",
                    3 => "catalog-card--sky",
                    4 => "catalog-card--peach",
                    _ => "catalog-card--cream"
                };

                <article class="catalog-card @variant">
                    <div class="catalog-card-image">
                        @if (!string.IsNullOrWhiteSpace(publicacion.ImagenUrl))
                        {
                            <img src="@publicacion.ImagenUrl" alt="@publicacion.Titulo" class="h-full w-full object-cover" />
                        }
                        <span class="catalog-card-tag">@(!string.IsNullOrWhiteSpace(publicacion.TipoPropuesta) ? publicacion.TipoPropuesta : "Publicación")</span>
                    </div>
                    <div class="catalog-card-body">
                        <h3>@publicacion.Titulo</h3>
                        <p class="mb-2 text-sm font-semibold text-[#4A403B]">@publicacion.NombreOrganizacion</p>
                        <p>@publicacion.Ubicacion</p>
                        <p class="mt-2 text-sm text-[#5B4E46]">@publicacion.Descripcion</p>
                        @if (publicacion.FechaLimite.HasValue)
                        {
                            <p class="mt-2 text-xs font-semibold uppercase tracking-[0.14em] text-[#5F6B6A]">Fecha límite: @publicacion.FechaLimite.Value.ToString("dd/MM/yyyy")</p>
                        }
                        <a href="/Catalogo/Detalle/@publicacion.Id" class="catalog-link">Conocer más →</a>
                    </div>
                </article>
            }
        }
        else
        {
            <div class="rounded-xl border border-yellow-200 bg-yellow-50 px-4 py-3 text-yellow-700">Todavía no hay publicaciones creadas.</div>
        }
    </section>
</div>
