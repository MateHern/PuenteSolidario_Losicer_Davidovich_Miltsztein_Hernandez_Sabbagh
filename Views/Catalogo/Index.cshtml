@model List<ProgramacionXEfsi_Puente.Models.Organizacion>
@{
    ViewData["Title"] = "Catálogo";
    var isLoggedIn = !string.IsNullOrWhiteSpace(Context.Session.GetString("Rol"));
    var categorias = ViewBag.Categorias as List<string> ?? new List<string>();
    var provincias = ViewBag.Provincias as List<string> ?? new List<string>();
    var categoriaSeleccionada = ViewBag.CategoriaSeleccionada as string ?? string.Empty;
    var ubicacionSeleccionada = ViewBag.UbicacionSeleccionada as string ?? string.Empty;
}

<div class="catalog-page app-shell">
    <header class="catalog-header">
        <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-3">
                <div class="site-brand-mark">P</div>
                <div class="site-brand">Puente Solidario</div>
            </div>

            <div class="hidden items-center gap-8 md:flex">
                <a href="/" class="text-lg font-medium text-[#3F322B]">Inicio</a>
                <a href="/Catalogo" class="text-lg font-medium text-[#3F322B] underline decoration-[#62C2B9] decoration-2 underline-offset-8">Catálogo</a>
                <a href="/Usuario/Perfil" class="text-lg font-medium text-[#3F322B]">Perfil</a>
            </div>

            <div class="flex items-center gap-3">
                @if (!isLoggedIn)
                {
                    <a href="/Cuenta/Login" class="rounded-full bg-[#F2E2D3] px-4 py-2 text-sm font-semibold text-[#3F322B]">Ingresar / Crear cuenta</a>
                }
                else
                {
                    <a href="/Cuenta/Logout" class="rounded-full bg-[#F2E2D3] px-4 py-2 text-sm font-semibold text-[#3F322B]">Cerrar sesión</a>
                }
            </div>
        </div>
    </header>

    <section class="catalog-hero px-4 md:px-6">
        <div class="catalog-title">Encontra una organización que te necesite</div>
        <p class="catalog-subtitle">Filtrá por tipo de ayuda, ubicación o grupo de personas</p>

        <form method="get" asp-controller="Catalogo" asp-action="Index" class="catalog-filters">
            <input type="text" name="busqueda" value="@ViewBag.Busqueda" placeholder="Buscar una causa..." class="filter-field" />

            <select name="categoria" class="filter-field">
                <option value="">Todos las categorías</option>
                @foreach (var categoria in categorias)
                {
                    <option value="@categoria" selected="@(categoria == categoriaSeleccionada ? "selected" : null)">@categoria</option>
                }
            </select>

            <select name="ubicacion" class="filter-field">
                <option value="">Todas las provincias</option>
                @foreach (var provincia in provincias)
                {
                    <option value="@provincia" selected="@(provincia == ubicacionSeleccionada ? "selected" : null)">@provincia</option>
                }
            </select>

            <button type="submit" class="catalog-btn">Aplicar filtros</button>
        </form>
    </section>

    <section class="catalog-grid px-4 md:px-6">
        @if (Model != null && Model.Any())
        {
            @foreach (var organizacion in Model)
            {
                var tone = (organizacion.Nombre?.Length ?? 0) % 6;
                var variant = tone switch
                {
                    0 => "catalog-card--orange",
                    1 => "catalog-card--yellow",
                    2 => "catalog-card--mint",
                    3 => "catalog-card--sky",
                    4 => "catalog-card--peach",
                    _ => "catalog-card--cream"
                };

                <article class="catalog-card @variant">
                    <div class="catalog-card-image">
                        <span class="catalog-card-tag">@((organizacion.Nombre?.Contains("volunt") == true ? "Voluntariado" : (organizacion.Nombre?.Contains("salud") == true ? "Salud" : "Donaciones")))</span>
                    </div>
                    <div class="catalog-card-body">
                        <h3>@organizacion.Nombre</h3>
                        <p>@organizacion.Direccion</p>
                        <a href="/Cuenta/Login" class="catalog-link">Conocer más →</a>
                    </div>
                </article>
            }
        }
        else
        {
            <div class="rounded-xl border border-yellow-200 bg-yellow-50 px-4 py-3 text-yellow-700">No hay organizaciones que coincidan con ese filtro.</div>
        }
    </section>
</div>

<footer class="site-footer">
    <div class="site-footer-inner">
        <div class="site-footer-brand">Puente Solidario · Ayudar nos conecta</div>
        <div class="site-footer-links">
            <a href="#">Contacto</a>
            <a href="#">Instagram</a>
            <a href="#">Privacidad</a>
            <span>© 2026</span>
        </div>
    </div>
</footer>
