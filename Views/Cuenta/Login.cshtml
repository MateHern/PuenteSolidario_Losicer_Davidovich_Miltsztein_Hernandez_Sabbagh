@model ProgramacionXEfsi_Puente.Models.LoginInput
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="login-page">
    <div class="login-shell">
        <div class="login-card">
            <h1 class="login-title">¡Qué bueno verte!</h1>
            <p class="login-subtitle">Iniciá sesión para continuar</p>

            <form asp-action="Login" asp-controller="Cuenta" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>

                <div class="login-form-group">
                    <label class="login-label">Tipo de cuenta</label>
                    <div class="grid gap-3 sm:grid-cols-2">
                        <label class="login-check flex items-center justify-center rounded-xl border border-[#E6CDB7] bg-white px-3 py-3 text-sm font-bold text-[#3F322B]">
                            <input asp-for="TipoCuenta" type="radio" value="Usuario" checked />
                            <span>Usuario</span>
                        </label>
                        <label class="login-check flex items-center justify-center rounded-xl border border-[#E6CDB7] bg-white px-3 py-3 text-sm font-bold text-[#3F322B]">
                            <input asp-for="TipoCuenta" type="radio" value="Ong" />
                            <span>ONG</span>
                        </label>
                    </div>
                    <span asp-validation-for="TipoCuenta" class="text-danger small d-block mt-2"></span>
                </div>

                <div class="login-form-group">
                    <label class="login-label">Correo electrónico</label>
                    <div class="login-input-wrap">
                        <input asp-for="Email" class="login-input" placeholder="Ingresá tu correo" />
                        <span class="input-icon">✉</span>
                    </div>
                    <span asp-validation-for="Email" class="text-danger small d-block mt-2"></span>
                </div>

                <div class="login-form-group">
                    <label class="login-label">Contraseña</label>
                    <div class="login-input-wrap">
                        <input asp-for="Password" type="password" class="login-input" placeholder="••••••••" />
                        <span class="input-icon">◉</span>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small d-block mt-2"></span>
                </div>

                <div class="login-row">
                    <label class="login-check">
                        <input type="checkbox" />
                        <span>Recordarme</span>
                    </label>
                    <a href="#" class="login-link-small">¿Olvidaste tu clave?</a>
                </div>

                <button type="submit" class="login-btn">Iniciar sesión</button>

                <a href="/Auth/RegistroPersonal" class="login-alt-btn d-block text-center leading-[3rem]">Crear cuenta personal →</a>
                <a href="/Auth/RegistroOrg" class="login-alt-btn d-block text-center leading-[3rem]">Registrar organización →</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
