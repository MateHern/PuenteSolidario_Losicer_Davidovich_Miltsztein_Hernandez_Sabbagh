@{
    ViewData["Title"] = "Inicio";
    var rol = Context.Session.GetString("Rol");
    var isLoggedIn = !string.IsNullOrWhiteSpace(rol);
    var isOng = string.Equals(rol, "Ong", StringComparison.OrdinalIgnoreCase);
    var isAdmin = string.Equals(rol, "Admin", StringComparison.OrdinalIgnoreCase);
    var nombre = ViewBag.UsuarioNombre as string ?? (isOng ? "ONG" : (isAdmin ? "Administrador" : "Usuario"));
}

@if (isLoggedIn && isOng)
{
    <div class="space-y-8 py-6 md:py-8">
        <div class="rounded-[30px] border border-[#E9DED2] bg-white p-6 shadow-sm">
            <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                <div>
                    <p class="text-xs font-extrabold uppercase tracking-[0.24em] text-[#FF7341]">Home de ONG</p>
                    <h1 class="mt-2 text-4xl font-black text-[#3F322B] md:text-5xl">@nombre</h1>
                </div>
                <a href="/Cuenta/Logout" class="rounded-full bg-[#3F322B] px-5 py-3 text-sm font-black text-white hover:bg-[#291f1c]">
                    Cerrar sesión
                </a>
            </div>
        </div>

        <div class="rounded-[30px] border border-[#E9DED2] bg-[#F9F5F1] p-6 shadow-sm">
            <h2 class="text-3xl font-black text-[#3F322B] md:text-4xl">¿Qué tipo de ayuda necesitás?</h2>
            <p class="mt-3 text-lg text-[#5B4E46]">Subí tu voluntariado o tu pedido de donación para que la gente lo vea.</p>

            <form asp-action="CrearPublicacion" asp-controller="Ong" method="post" class="mt-8 space-y-6">
                @Html.AntiForgeryToken()

                <div class="grid gap-6 md:grid-cols-3">
                    <div>
                        <label class="mb-2 block text-sm font-extrabold uppercase tracking-[0.12em] text-[#3F322B]">Nombre del pedido</label>
                        <input type="text" name="nombreDelPedido" class="w-full rounded-xl border border-[#DCC8BA] bg-white px-4 py-3 text-sm text-[#3F322B] outline-none transition focus:border-[#FF7341] focus:ring-2 focus:ring-[#FFD7C5]" placeholder="ej: Abrigo en invierno" />
                    </div>

                    <div>
                        <label class="mb-2 block text-sm font-extrabold uppercase tracking-[0.12em] text-[#3F322B]">Tipo de propuesta</label>
                        <select name="tipoDePropuesta" class="w-full rounded-xl border border-[#DCC8BA] bg-white px-4 py-3 text-sm text-[#3F322B] outline-none transition focus:border-[#FF7341] focus:ring-2 focus:ring-[#FFD7C5]">
                            <option value="Donación">Donación</option>
                            <option value="Voluntariado">Voluntariado</option>
                            <option value="PlacaHonder">PlacaHonder</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>

                    <div>
                        <label class="mb-2 block text-sm font-extrabold uppercase tracking-[0.12em] text-[#3F322B]">Descripción</label>
                        <input type="text" name="descripcion" class="w-full rounded-xl border border-[#DCC8BA] bg-white px-4 py-3 text-sm text-[#3F322B] outline-none transition focus:border-[#FF7341] focus:ring-2 focus:ring-[#FFD7C5]" placeholder="Describí para qué se va a usar" />
                    </div>
                </div>

                <div class="grid gap-6 md:grid-cols-2">
                    <div>
                        <label class="mb-2 block text-sm font-extrabold uppercase tracking-[0.12em] text-[#3F322B]">Ubicación</label>
                        <input type="text" name="ubicacion" class="w-full rounded-xl border border-[#DCC8BA] bg-white px-4 py-3 text-sm text-[#3F322B] outline-none transition focus:border-[#FF7341] focus:ring-2 focus:ring-[#FFD7C5]" placeholder="ej: Yatay 240, CABA" />
                    </div>

                    <div>
                        <label class="mb-2 block text-sm font-extrabold uppercase tracking-[0.12em] text-[#3F322B]">Cosas que se necesitan</label>
                        <input type="text" name="cosasQueNecesitan" class="w-full rounded-xl border border-[#DCC8BA] bg-white px-4 py-3 text-sm text-[#3F322B] outline-none transition focus:border-[#FF7341] focus:ring-2 focus:ring-[#FFD7C5]" placeholder="ej: abrigos, camperas, comida" />
                    </div>
                </div>

                <div class="rounded-[24px] border-[3px] border-[#FFEF87] bg-[#FFF7D6] p-8 text-center">
                    <div class="mb-4 flex justify-center">
                        <div class="flex h-16 w-16 items-center justify-center rounded-full bg-[#62C2B9] text-3xl font-bold text-white">☁</div>
                    </div>
                    <h3 class="text-3xl font-black text-[#3F322B]">Subí imágenes de tu propuesta</h3>
                    <p class="mt-3 text-lg text-[#5B4E46]">JPG o PNG - Podés agregar más de una imagen</p>
                    <button type="button" class="mt-8 inline-flex h-16 w-16 items-center justify-center rounded-full bg-[#62C2B9] text-5xl font-light text-white shadow-sm">+</button>
                </div>

                <button type="submit" class="w-full rounded-xl bg-[#62C2B9] px-4 py-4 text-xl font-bold text-white shadow-sm transition hover:bg-[#4CB0A4]">
                    Crear publicación
                </button>
            </form>
        </div>
    </div>
}
else if (isLoggedIn && isAdmin)
{
    <section class="space-y-8 py-6 md:py-8">
        <div class="rounded-[30px] border border-[#E9DED2] bg-white p-6 shadow-sm">
            <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                <div>
                    <p class="text-xs font-extrabold uppercase tracking-[0.24em] text-[#FF7341]">Panel de administración</p>
                    <h1 class="mt-2 text-4xl font-black text-[#3F322B] md:text-5xl">@nombre</h1>
                </div>
                <a href="/Cuenta/Logout" class="rounded-full bg-[#3F322B] px-5 py-3 text-sm font-black text-white hover:bg-[#291f1c]">
                    Cerrar sesión
                </a>
            </div>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
            <a href="/Admin/AprobarOngs" class="rounded-[24px] border border-[#E9DED2] bg-[#F9F5F1] p-6 shadow-sm transition hover:bg-[#F4EFEA]">
                <p class="text-sm font-extrabold uppercase tracking-[0.22em] text-[#FF7341]">ONGs</p>
                <h2 class="mt-3 text-3xl font-black text-[#3F322B]">Aprobar solicitudes</h2>
                <p class="mt-2 text-[#5B4E46]">Revisá y validá las organizaciones pendientes.</p>
            </a>

            <a href="/Admin/CrearAdmin" class="rounded-[24px] border border-[#E9DED2] bg-[#F9F5F1] p-6 shadow-sm transition hover:bg-[#F4EFEA]">
                <p class="text-sm font-extrabold uppercase tracking-[0.22em] text-[#FF7341]">Administración</p>
                <h2 class="mt-3 text-3xl font-black text-[#3F322B]">Crear administrador</h2>
                <p class="mt-2 text-[#5B4E46]">Generá nuevas cuentas administrativas.</p>
            </a>
        </div>
    </section>
}
else
{
    <section class="home-hero overflow-hidden rounded-[32px]">
        <div class="mx-auto grid max-w-7xl items-center gap-10 px-6 py-12 lg:grid-cols-[1.2fr_0.8fr] lg:px-10 lg:py-16">
            <div>
                @if (isLoggedIn)
                {
                    <p class="mb-4 text-sm font-extrabold uppercase tracking-[0.22em] text-[#FF7341]">Bienvenido/a</p>
                    <h1 class="max-w-xl text-4xl font-black leading-tight text-[#3F322B] md:text-5xl">@nombre</h1>
                    <p class="mt-4 max-w-lg text-base leading-7 text-[#5B4E46] md:text-lg">Tu espacio de acción solidaria está listo para seguir apoyando causas reales.</p>
                }
                else
                {
                    <p class="mb-4 text-sm font-extrabold uppercase tracking-[0.22em] text-[#FF7341]">Haz la diferencia</p>
                    <h1 class="max-w-xl text-4xl font-black leading-tight text-[#3F322B] md:text-5xl">TU AYUDA PUEDE CAMBIAR UNA HISTORIA</h1>
                }

                <p class="mt-6 max-w-lg text-base leading-7 text-[#5B4E46] md:text-lg">Conectamos personas, organizaciones y causas para transformar necesidades reales en apoyo concreto, cercano y sostenido.</p>

                <div class="mt-8 flex flex-wrap items-center gap-4">
                    @if (isLoggedIn)
                    {
                        <a href="/Catalogo" class="inline-flex items-center justify-center rounded-full bg-[#FF7341] px-7 py-3 text-base font-black text-white shadow-md transition hover:bg-[#EA6235]">
                            Ver catálogo
                        </a>
                    }
                    else
                    {
                        <a href="/Cuenta/Login" class="inline-flex items-center justify-center rounded-full bg-[#FF7341] px-7 py-3 text-base font-black text-white shadow-md transition hover:bg-[#EA6235]">
                            Ingresar
                        </a>
                        <a href="/Auth/RegistroPersonal" class="inline-flex items-center justify-center rounded-full border border-[#D9D1CA] bg-white px-7 py-3 text-base font-black text-[#3F322B] shadow-sm transition hover:bg-[#F8F5F2]">
                            Crear cuenta
                        </a>
                    }
                </div>
            </div>

            <div class="relative">
                <div class="rounded-[30px] bg-white p-5 shadow-sm ring-1 ring-[#E9DED2]">
                    <div class="grid gap-4 sm:grid-cols-2">
                        <div class="rounded-[24px] bg-[#FFF8EA] p-5">
                            <p class="text-sm font-extrabold uppercase tracking-[0.18em] text-[#FF7341]">Donaciones</p>
                            <h3 class="mt-3 text-3xl font-black text-[#3F322B]">15.400</h3>
                            <p class="mt-2 text-sm text-[#5B4E46]">aportes concretos del mes</p>
                        </div>
                        <div class="rounded-[24px] bg-[#E7F7F5] p-5">
                            <p class="text-sm font-extrabold uppercase tracking-[0.18em] text-[#FF7341]">Personas</p>
                            <h3 class="mt-3 text-3xl font-black text-[#3F322B]">8.200</h3>
                            <p class="mt-2 text-sm text-[#5B4E46]">beneficiadas</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
