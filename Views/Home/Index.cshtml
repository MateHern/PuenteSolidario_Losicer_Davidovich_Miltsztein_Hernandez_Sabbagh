@{
    ViewData["Title"] = "Inicio";
    var isLoggedIn = ViewBag.IsLoggedIn as bool? ?? false;
}

<section class="overflow-hidden rounded-[28px] bg-[#F4EDE3]">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-6 py-12 lg:grid-cols-2 lg:px-10 lg:py-16">
        <div>
            @if (isLoggedIn)
            {
                <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-[#7A6050]">Acción social</p>
                <h1 class="max-w-xl text-4xl font-black leading-tight text-[#2F2A28] md:text-5xl">
                    TU SOLIDARIDAD DEJA HUELLA
                </h1>
            }
            else
            {
                <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-[#7A6050]">Haz la diferencia</p>
                <h1 class="max-w-xl text-4xl font-black leading-tight text-[#2F2A28] md:text-5xl">
                    TU AYUDA PUEDE CAMBIAR UNA HISTORIA
                </h1>
            }

            <p class="mt-6 max-w-lg text-base leading-7 text-[#4A403B] md:text-lg">
                Conectamos personas, organizaciones y causas para transformar necesidades reales en apoyo concreto, cercano y sostenido.
            </p>

            <div class="mt-8 flex flex-wrap items-center gap-4">
                @if (isLoggedIn)
                {
                    <a href="/Catalogo" class="inline-flex items-center justify-center rounded-full bg-[#D98C48] px-7 py-3 text-base font-semibold text-white shadow-md transition hover:bg-[#c77b38]">
                        DONAR
                    </a>
                    <a href="/Mapa" class="text-base font-semibold text-[#3E3631] underline decoration-[#D98C48] underline-offset-4 transition hover:text-[#7A6050]">
                        Ver Mapa
                    </a>
                }
                else
                {
                    <a href="/Auth/Login" class="inline-flex items-center justify-center rounded-full bg-[#D98C48] px-7 py-3 text-base font-semibold text-white shadow-md transition hover:bg-[#c77b38]">
                        DONAR
                    </a>
                }
            </div>
        </div>

        <div>
            @if (isLoggedIn)
            {
                <div class="rounded-[24px] border border-[#E9E2DA] bg-white p-8 shadow-[0_18px_45px_rgba(62,54,49,0.08)]">
                    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#8A7466]">Impacto</p>
                    <h2 class="mt-4 text-3xl font-black text-[#2F2A28]">TU IMPACTO: 3 aportes realizados</h2>
                    <div class="mt-6 h-44 rounded-2xl bg-[#F6F1EB] p-6">
                        <div class="flex h-full items-end gap-3">
                            <div class="w-1/4 rounded-t-2xl bg-[#D98C48]" style="height: 35%;"></div>
                            <div class="w-1/4 rounded-t-2xl bg-[#C9B39A]" style="height: 55%;"></div>
                            <div class="w-1/4 rounded-t-2xl bg-[#D7C7B2]" style="height: 75%;"></div>
                            <div class="w-1/4 rounded-t-2xl bg-[#A87C5A]" style="height: 90%;"></div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="h-[360px] w-full rounded-[28px] bg-[#E6E1DD] shadow-inner"></div>
            }
        </div>
    </div>
</section>

<section class="mt-16 px-1">
    <div class="mb-8 text-center">
        <h2 class="text-3xl font-black text-[#2F2A28] md:text-4xl">Pequeñas acciones, grandes cambios</h2>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <article class="rounded-[24px] border border-[#F0EAE4] bg-[#F5F3F1] p-5 shadow-sm">
            <div class="mb-5 h-32 rounded-2xl bg-[#E6E1DD]"></div>
            <h3 class="text-2xl font-bold text-[#2F2A28]">Donaciones</h3>
            <p class="mt-3 text-base leading-7 text-[#4A403B]">
                Aporta recursos esenciales para apoyar a familias, centros y proyectos locales con impacto inmediato.
            </p>
            <a href="/Catalogo" class="mt-5 inline-flex items-center text-base font-semibold text-[#3E3631] hover:text-[#7A6050]">
                Conocer más -&gt;
            </a>
        </article>

        <article class="rounded-[24px] border border-[#F0EAE4] bg-[#F5F3F1] p-5 shadow-sm">
            <div class="mb-5 h-32 rounded-2xl bg-[#E6E1DD]"></div>
            <h3 class="text-2xl font-bold text-[#2F2A28]">Voluntariados</h3>
            <p class="mt-3 text-base leading-7 text-[#4A403B]">
                Suma tu tiempo y capacidades para acompañar, organizar y fortalecer comunidades que reciben apoyo.
            </p>
            <a href="/Catalogo" class="mt-5 inline-flex items-center text-base font-semibold text-[#3E3631] hover:text-[#7A6050]">
                Conocer más -&gt;
            </a>
        </article>

        <article class="rounded-[24px] border border-[#F0EAE4] bg-[#F5F3F1] p-5 shadow-sm">
            <div class="mb-5 h-32 rounded-2xl bg-[#E6E1DD]"></div>
            <h3 class="text-2xl font-bold text-[#2F2A28]">Organizaciones</h3>
            <p class="mt-3 text-base leading-7 text-[#4A403B]">
                Descubre instituciones que trabajan en causas concretas y encuentra maneras de apoyar colaborativamente.
            </p>
            <a href="/Catalogo" class="mt-5 inline-flex items-center text-base font-semibold text-[#3E3631] hover:text-[#7A6050]">
                Conocer más -&gt;
            </a>
        </article>
    </div>
</section>
