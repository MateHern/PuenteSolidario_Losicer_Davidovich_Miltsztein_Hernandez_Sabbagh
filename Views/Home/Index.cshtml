@{
    ViewData["Title"] = "Inicio";
    var rol = Context.Session.GetString("Rol");
    var isLoggedIn = !string.IsNullOrWhiteSpace(rol);
    var isOng = string.Equals(rol, "Ong", StringComparison.OrdinalIgnoreCase);
    var isAdmin = string.Equals(rol, "Admin", StringComparison.OrdinalIgnoreCase);
    var nombre = ViewBag.UsuarioNombre as string ?? (isOng ? "ONG" : (isAdmin ? "Administrador" : "Usuario"));
}

@if (isLoggedIn && isOng)
{
    <section class="home-hero overflow-hidden rounded-[32px]">
        <div class="mx-auto grid max-w-7xl items-center gap-10 px-6 py-12 lg:grid-cols-[1.2fr_0.8fr] lg:px-10 lg:py-16">
            <div>
                <p class="mb-4 text-sm font-extrabold uppercase tracking-[0.22em] text-[#FF7341]">Bienvenido/a</p>
                <h1 class="max-w-xl text-4xl font-black leading-tight text-[#3F322B] md:text-5xl">@nombre</h1>
                <p class="mt-4 max-w-lg text-base leading-7 text-[#5B4E46] md:text-lg">Tu espacio de acción solidaria está listo para publicar necesidades y seguir conectando con personas que quieren aportar.</p>

                <div class="mt-8 flex flex-wrap items-center gap-4">
                    <a href="/Catalogo" class="inline-flex items-center justify-center rounded-full bg-[#FF7341] px-7 py-3 text-base font-black text-white shadow-md transition hover:bg-[#EA6235]">
                        Ver catálogo
                    </a>
                    <a href="/Ong/Dashboard" class="inline-flex items-center justify-center rounded-full border border-[#D9D1CA] bg-white px-7 py-3 text-base font-black text-[#3F322B] shadow-sm transition hover:bg-[#F8F5F2]">
                        Panel ONG
                    </a>
                </div>
            </div>

            <div class="relative">
                <div class="rounded-[30px] bg-white p-5 shadow-sm ring-1 ring-[#E9DED2]">
                    <div class="grid gap-4 sm:grid-cols-2">
                        <div class="rounded-[24px] bg-[#FFF8EA] p-5">
                            <p class="text-sm font-extrabold uppercase tracking-[0.18em] text-[#FF7341]">Publicaciones</p>
                            <h3 class="mt-3 text-3xl font-black text-[#3F322B]">Activas</h3>
                            <p class="mt-2 text-sm text-[#5B4E46]">Conectá tu causa con ayuda real.</p>
                        </div>
                        <div class="rounded-[24px] bg-[#E7F7F5] p-5">
                            <p class="text-sm font-extrabold uppercase tracking-[0.18em] text-[#FF7341]">Voluntariado</p>
                            <h3 class="mt-3 text-3xl font-black text-[#3F322B]">Disponible</h3>
                            <p class="mt-2 text-sm text-[#5B4E46]">Sumá apoyo humano y concreto.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
else if (isLoggedIn && isAdmin)
{
    <section class="space-y-8 py-6 md:py-8">
        <div class="rounded-[30px] border border-[#E9DED2] bg-white p-6 shadow-sm">
            <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                <div>
                    <p class="text-xs font-extrabold uppercase tracking-[0.24em] text-[#FF7341]">Panel de administración</p>
                    <h1 class="mt-2 text-4xl font-black text-[#3F322B] md:text-5xl">@nombre</h1>
                </div>
                <a href="/Cuenta/Logout" class="rounded-full bg-[#3F322B] px-5 py-3 text-sm font-black text-white hover:bg-[#291f1c]">
                    Cerrar sesión
                </a>
            </div>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
            <a href="/Admin/AprobarOngs" class="rounded-[24px] border border-[#E9DED2] bg-[#F9F5F1] p-6 shadow-sm transition hover:bg-[#F4EFEA]">
                <p class="text-sm font-extrabold uppercase tracking-[0.22em] text-[#FF7341]">ONGs</p>
                <h2 class="mt-3 text-3xl font-black text-[#3F322B]">Aprobar solicitudes</h2>
                <p class="mt-2 text-[#5B4E46]">Revisá y validá las organizaciones pendientes.</p>
            </a>

            <a href="/Admin/CrearAdmin" class="rounded-[24px] border border-[#E9DED2] bg-[#F9F5F1] p-6 shadow-sm transition hover:bg-[#F4EFEA]">
                <p class="text-sm font-extrabold uppercase tracking-[0.22em] text-[#FF7341]">Administración</p>
                <h2 class="mt-3 text-3xl font-black text-[#3F322B]">Crear administrador</h2>
                <p class="mt-2 text-[#5B4E46]">Generá nuevas cuentas administrativas.</p>
            </a>
        </div>
    </section>
}
else
{
    <section class="home-hero overflow-hidden rounded-[32px]">
        <div class="mx-auto grid max-w-7xl items-center gap-10 px-6 py-12 lg:grid-cols-[1.2fr_0.8fr] lg:px-10 lg:py-16">
            <div>
                @if (isLoggedIn)
                {
                    <p class="mb-4 text-sm font-extrabold uppercase tracking-[0.22em] text-[#FF7341]">Bienvenido/a</p>
                    <h1 class="max-w-xl text-4xl font-black leading-tight text-[#3F322B] md:text-5xl">@nombre</h1>
                    <p class="mt-4 max-w-lg text-base leading-7 text-[#5B4E46] md:text-lg">Tu espacio de acción solidaria está listo para seguir apoyando causas reales.</p>
                }
                else
                {
                    <p class="mb-4 text-sm font-extrabold uppercase tracking-[0.22em] text-[#FF7341]">Haz la diferencia</p>
                    <h1 class="max-w-xl text-4xl font-black leading-tight text-[#3F322B] md:text-5xl">TU AYUDA PUEDE CAMBIAR UNA HISTORIA</h1>
                }

                <p class="mt-6 max-w-lg text-base leading-7 text-[#5B4E46] md:text-lg">Conectamos personas, organizaciones y causas para transformar necesidades reales en apoyo concreto, cercano y sostenido.</p>

                <div class="mt-8 flex flex-wrap items-center gap-4">
                    @if (isLoggedIn)
                    {
                        <a href="/Catalogo" class="inline-flex items-center justify-center rounded-full bg-[#FF7341] px-7 py-3 text-base font-black text-white shadow-md transition hover:bg-[#EA6235]">
                            Ver catálogo
                        </a>
                    }
                    else
                    {
                        <a href="/Cuenta/Login" class="inline-flex items-center justify-center rounded-full bg-[#FF7341] px-7 py-3 text-base font-black text-white shadow-md transition hover:bg-[#EA6235]">
                            Ingresar
                        </a>
                        <a href="/Auth/RegistroPersonal" class="inline-flex items-center justify-center rounded-full border border-[#D9D1CA] bg-white px-7 py-3 text-base font-black text-[#3F322B] shadow-sm transition hover:bg-[#F8F5F2]">
                            Crear cuenta
                        </a>
                    }
                </div>
            </div>

            <div class="relative">
                <div class="rounded-[30px] bg-white p-5 shadow-sm ring-1 ring-[#E9DED2]">
                    <div class="grid gap-4 sm:grid-cols-2">
                        <div class="rounded-[24px] bg-[#FFF8EA] p-5">
                            <p class="text-sm font-extrabold uppercase tracking-[0.18em] text-[#FF7341]">Donaciones</p>
                            <h3 class="mt-3 text-3xl font-black text-[#3F322B]">15.400</h3>
                            <p class="mt-2 text-sm text-[#5B4E46]">aportes concretos del mes</p>
                        </div>
                        <div class="rounded-[24px] bg-[#E7F7F5] p-5">
                            <p class="text-sm font-extrabold uppercase tracking-[0.18em] text-[#FF7341]">Personas</p>
                            <h3 class="mt-3 text-3xl font-black text-[#3F322B]">8.200</h3>
                            <p class="mt-2 text-sm text-[#5B4E46]">beneficiadas</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<section class="impact-comments-section">
    <div class="impact-comments-heading">
        <div>
            <p class="impact-comments-kicker">Pequeñas acciones, grandes cambios</p>
            <h2 class="impact-comments-title">Historias de ayuda real</h2>
        </div>
    </div>

    <div class="impact-story-grid">
        <article class="impact-story-card impact-story-peach">
            <div class="impact-story-image">
                <span class="impact-story-tag">Donaciones</span>
                <span class="impact-story-emoji">🎁</span>
            </div>
            <h3>Una ayuda que llegó a tiempo</h3>
            <p>Una comunidad pudo compartir alimentos, ropa y productos esenciales con familias que lo necesitaban.</p>
        </article>

        <article class="impact-story-card impact-story-mint">
            <div class="impact-story-image">
                <span class="impact-story-tag">Voluntariado</span>
                <span class="impact-story-emoji">🤝</span>
            </div>
            <h3>Voluntarios que hacen equipo</h3>
            <p>Personas y organizaciones sumaron su tiempo y trabajo para acompañar proyectos de barrio.</p>
        </article>

        <article class="impact-story-card impact-story-sky">
            <div class="impact-story-image">
                <span class="impact-story-tag">Organizaciones</span>
                <span class="impact-story-emoji">♡</span>
            </div>
            <h3>Causas cercanas y visibles</h3>
            <p>Las ONG pudieron compartir sus necesidades y recibir apoyo concreto de quienes quieren colaborar.</p>
        </article>
    </div>

    @if (TempData["ComentarioExito"] != null)
    {
        <div class="comment-success">@TempData["ComentarioExito"]</div>
    }
    @if (TempData["ComentarioError"] != null)
    {
        <div class="comment-error">@TempData["ComentarioError"]</div>
    }

    @if (isLoggedIn && (string.Equals(rol, "Usuario", StringComparison.OrdinalIgnoreCase) || isOng))
    {
        <form asp-action="AgregarComentario" asp-controller="Home" method="post" class="comment-form">
            @Html.AntiForgeryToken()
            <div class="comment-form-heading">
                <div class="comment-author-avatar">@(isOng ? "ONG" : "YO")</div>
                <div>
                    <strong>@nombre</strong>
                    <span>@(isOng ? "Organización" : "Usuario")</span>
                </div>
            </div>
            <label for="textoComentario" class="comment-label">Contanos tu experiencia</label>
            <textarea id="textoComentario" name="texto" maxlength="500" rows="4" class="comment-textarea" placeholder="Escribí tu comentario..."></textarea>
            <div class="comment-form-footer">
                <small>Máximo 500 caracteres</small>
                <button type="submit" class="comment-submit">Publicar comentario</button>
            </div>
        </form>
    }
    else if (!isLoggedIn)
    {
        <div class="comment-login-callout">
            <div>
                <strong>¿Viviste una experiencia solidaria?</strong>
                <span>Iniciá sesión para compartir tu comentario.</span>
            </div>
            <a href="/Cuenta/Login">Iniciar sesión</a>
        </div>
    }

    <div class="community-comments">
        @{
            var comentarios = ViewBag.ComentariosLanding as List<ProgramacionXEfsi_Puente.Models.ComentarioLanding>
                ?? new List<ProgramacionXEfsi_Puente.Models.ComentarioLanding>();
        }

        @if (comentarios.Count == 0)
        {
            <article class="community-comment community-comment-placeholder">
                <div class="community-avatar">✦</div>
                <div>
                    <div class="community-comment-name">Hospital Garrahan</div>
                    <div class="community-stars">★★★★★</div>
                    <p>Gracias a esta plataforma podemos dar a conocer nuestro trabajo y llegar a personas que quieren colaborar con nuestra misión.</p>
                </div>
            </article>
        }
        else
        {
            foreach (var comentario in comentarios)
            {
                var inicial = comentario.Nombre.Length > 0 ? comentario.Nombre.Substring(0, 1).ToUpperInvariant() : "U";
                <article class="community-comment">
                    <div class="community-avatar">@inicial</div>
                    <div>
                        <div class="community-comment-name">@comentario.Nombre</div>
                        <div class="community-role">@(string.Equals(comentario.Rol, "Ong", StringComparison.OrdinalIgnoreCase) ? "Organización" : "Usuario")</div>
                        <p>@comentario.Texto</p>
                    </div>
                </article>
            }
        }
    </div>
</section>
