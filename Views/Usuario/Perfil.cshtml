@model ProgramacionXEfsi_Puente.Models.Usuario
@{
    var nombre = string.IsNullOrWhiteSpace(Model?.Nombre) ? "Usuario" : Model.Nombre;
    var email = string.IsNullOrWhiteSpace(Model?.Email) ? "usuario@ejemplo.com" : Model.Email;
}

<div class="min-h-screen bg-[#f9f7f4] px-4 py-8 md:px-8 xl:px-10">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 lg:grid-cols-[300px_minmax(0,1fr)]">

        <aside class="rounded-[32px] bg-[#f4efe9] p-6 shadow-sm ring-1 ring-[#efe7df]">
            <div class="flex flex-col items-center">
                <div class="mb-5 flex h-28 w-28 items-center justify-center rounded-full bg-[#1d1d1c] text-3xl font-bold text-white shadow-inner">
                    M
                </div>

                <h2 class="text-2xl font-bold text-[#1f1f1f]">Hola @nombre</h2>
                <p class="mt-1 text-sm text-[#6f6b68]">@email</p>
            </div>

            <nav class="mt-8 space-y-3">
                <a href="#" class="group flex items-center gap-3 rounded-2xl bg-[#f8d7ba] px-4 py-3 text-sm font-semibold text-[#2c2a28] shadow-sm transition hover:bg-[#f4cfa5]">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21a8 8 0 0 0-16 0"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                    Mi Perfil
                </a>

                <a href="#" class="group flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-medium text-[#534d49] transition hover:bg-[#f7f2ee] hover:text-[#201f1d]">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 21s-8.5-4.35-8.5-10.8A4.94 4.94 0 0 1 8.5 6a5.27 5.27 0 0 1 3.5 1.5A5.27 5.27 0 0 1 15.5 6a4.94 4.94 0 0 1 5 4.2C20.5 16.65 12 21 12 21Z"/>
                    </svg>
                    Mis Donaciones
                </a>

                <a href="#" class="group flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-medium text-[#534d49] transition hover:bg-[#f7f2ee] hover:text-[#201f1d]">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3"/>
                        <path d="M19.4 15a1.7 1.7 0 0 0 .34 1.9l.06.06a2 2 0 0 1 0 2.8 2 2 0 0 1-2.8 0l-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .9 1.7 1.7 0 0 0-.17 1.1 2 2 0 0 1-4 0 1.7 1.7 0 0 0-.17-1.1 1.7 1.7 0 0 0-1-.9 1.7 1.7 0 0 0-1.9.34l-.06.06a2 2 0 0 1-2.8 0 2 2 0 0 1 0-2.8l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.9-1 1.7 1.7 0 0 0-1.1-.17 2 2 0 0 1 0-4 1.7 1.7 0 0 0 1.1-.17 1.7 1.7 0 0 0 .9-1 1.7 1.7 0 0 0-.34-1.9l-.06-.06a2 2 0 0 1 0-2.8 2 2 0 0 1 2.8 0l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.9 1.7 1.7 0 0 0 .17-1.1 2 2 0 0 1 4 0 1.7 1.7 0 0 0 .17 1.1 1.7 1.7 0 0 0 1 .9 1.7 1.7 0 0 0 1.9-.34l.06-.06a2 2 0 0 1 2.8 0 2 2 0 0 1 0 2.8l-.06.06A1.7 1.7 0 0 0 19.4 9c.2.39.35.84.35 1.3a1.7 1.7 0 0 0 .35 1.3 1.7 1.7 0 0 0 .9 1 1.7 1.7 0 0 0 1.1.17 2 2 0 0 1 0 4 1.7 1.7 0 0 0-1.1.17 1.7 1.7 0 0 0-.9 1Z"/>
                    </svg>
                    Configuración
                </a>

                <a href="#" class="group flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-medium text-[#534d49] transition hover:bg-[#f7f2ee] hover:text-[#201f1d]">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10 17 5 12l5-5"/>
                        <path d="M5 12h9a6 6 0 0 1 0 12h-3"/>
                    </svg>
                    Cerrar Sesión
                </a>
            </nav>
        </aside>

        <main class="space-y-8">
            <section class="rounded-[32px] bg-white p-5 shadow-sm ring-1 ring-[#f0e9e2] md:p-7">
                <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
                    <div class="flex items-center gap-5">
                        <div class="h-28 w-28 overflow-hidden rounded-[28px] bg-gradient-to-br from-[#f6e8df] via-[#f0d0ad] to-[#e7c3a5] shadow-inner">
                            <svg viewBox="0 0 240 240" class="h-full w-full" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <g fill="none" fill-rule="evenodd">
                                    <path d="M56 110c0-28 22-50 50-50 22 0 40 13 48 31 6-6 14-9 24-9 18 0 33 15 33 33v35c0 30-23 53-52 53H100c-31 0-56-25-56-56v-4c0-19 15-35 35-35Z" fill="#f7d7b6"/>
                                    <path d="M95 78c-22 1-38 18-38 39 0 17 7 28 19 38 12 10 24 17 21 30l-2 11h31l-2-11c-4-14 8-21 21-31 12-10 19-21 19-38 0-21-16-38-38-39-11 0-21 4-29 12-8-8-18-12-30-12Z" fill="#d99b66" opacity=".5"/>
                                    <path d="M88 84c-6 0-12 2-17 6 9 7 16 19 20 34 2 8 4 18 2 27l-2 9h30l-2-10c-2-11 0-23 6-33 6-12 17-22 31-28-5-15-20-26-35-26-18 0-31 10-33 21Z" fill="#c77d49" opacity=".7"/>
                                    <circle cx="88" cy="95" r="12" fill="#fff4ea"/>
                                    <circle cx="152" cy="95" r="12" fill="#fff4ea"/>
                                    <path d="M90 126c10 10 20 16 31 16s21-6 30-16" stroke="#fff4ea" stroke-width="8" stroke-linecap="round"/>
                                </g>
                            </svg>
                        </div>

                        <div>
                            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#8d7d72]">Perfil</p>
                            <h1 class="mt-2 text-3xl font-black text-[#1f1f1f] md:text-4xl">Hola @nombre!</h1>
                            <p class="mt-2 max-w-xl text-base leading-7 text-[#544c47]">
                                Gracias por ser parte de Puente Solidario. Juntos podemos crear un impacto positivo.
                            </p>
                        </div>
                    </div>

                    <button class="inline-flex items-center gap-2 rounded-full bg-[#1f1f1f] px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-[#2a2a29]">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 20h9"/>
                            <path d="M16.5 3.5a2.1 2.1 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5Z"/>
                        </svg>
                        Editar perfil
                    </button>
                </div>
            </section>

            <section class="rounded-[32px] bg-white p-6 shadow-sm ring-1 ring-[#f0e9e2] md:p-7">
                <h2 class="text-2xl font-bold text-[#1f1f1f]">Tu actividad</h2>

                <div class="mt-6 grid gap-5 md:grid-cols-2">
                    <div class="flex items-center gap-4 rounded-[28px] bg-[#fffaf5] p-5 ring-1 ring-[#f5e3d2]">
                        <div class="flex h-16 w-16 items-center justify-center rounded-full bg-[#f8d7ba] text-[#3c2f2b]">
                            <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 21s-8.5-4.35-8.5-10.8A4.94 4.94 0 0 1 8.5 6a5.27 5.27 0 0 1 3.5 1.5A5.27 5.27 0 0 1 15.5 6a4.94 4.94 0 0 1 5 4.2C20.5 16.65 12 21 12 21Z"/>
                            </svg>
                        </div>

                        <div>
                            <div class="text-4xl font-black leading-none text-[#1f1f1f]">5</div>
                            <p class="mt-2 text-sm text-[#5d5651]">Donaciones realizadas</p>
                        </div>
                    </div>

                    <div class="flex items-center gap-4 rounded-[28px] bg-[#eef8ff] p-5 ring-1 ring-[#dfeef9]">
                        <div class="flex h-16 w-16 items-center justify-center rounded-full bg-[#d9ebff] text-[#1d3f66]">
                            <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M7 10V5.5A1.5 1.5 0 0 1 8.5 4H15.5A1.5 1.5 0 0 1 17 5.5V10"/>
                                <path d="M5 10h14v9.5A1.5 1.5 0 0 1 17.5 21h-11A1.5 1.5 0 0 1 5 19.5V10Z"/>
                                <path d="M9 14h6"/>
                            </svg>
                        </div>

                        <div>
                            <div class="text-4xl font-black leading-none text-[#1f1f1f]">+1000</div>
                            <p class="mt-2 text-sm text-[#5d5651]">Personas beneficiadas</p>
                        </div>
                    </div>
                </div>
            </section>

            <section class="rounded-[32px] bg-white p-6 shadow-sm ring-1 ring-[#f0e9e2] md:p-7">
                <h2 class="text-2xl font-bold text-[#1f1f1f]">Historial de aportes</h2>

                <div class="mt-6 grid gap-6 xl:grid-cols-[1.3fr_1fr]">
                    <div class="space-y-4">
                        <div class="flex items-center justify-between rounded-2xl bg-[#faf7f4] px-4 py-3 ring-1 ring-[#f0e8e2]">
                            <div class="flex items-center gap-3">
                                <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[#f4d7b8] text-[#3d2f2b]">
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 21s-8.5-4.35-8.5-10.8A4.94 4.94 0 0 1 8.5 6a5.27 5.27 0 0 1 3.5 1.5A5.27 5.27 0 0 1 15.5 6a4.94 4.94 0 0 1 5 4.2C20.5 16.65 12 21 12 21Z"/>
                                    </svg>
                                </div>
                                <div>
                                    <p class="font-semibold text-[#1e1e1e]">Refugio patitas felices</p>
                                    <p class="text-xs text-[#7b726d]">12 de julio 2026</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="text-lg font-bold text-[#1d1d1d]">$12.000</span>
                                <svg class="h-5 w-5 text-[#736c68]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m9 18 6-6-6-6"/>
                                </svg>
                            </div>
                        </div>

                        <div class="flex items-center justify-between rounded-2xl bg-[#faf7f4] px-4 py-3 ring-1 ring-[#f0e8e2]">
                            <div class="flex items-center gap-3">
                                <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[#cfe7ff] text-[#1d3f66]">
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 21s-8.5-4.35-8.5-10.8A4.94 4.94 0 0 1 8.5 6a5.27 5.27 0 0 1 3.5 1.5A5.27 5.27 0 0 1 15.5 6a4.94 4.94 0 0 1 5 4.2C20.5 16.65 12 21 12 21Z"/>
                                    </svg>
                                </div>
                                <div>
                                    <p class="font-semibold text-[#1e1e1e]">Comedor comunitario</p>
                                    <p class="text-xs text-[#7b726d]">4 de julio 2026</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="text-lg font-bold text-[#1d1d1d]">$8.500</span>
                                <svg class="h-5 w-5 text-[#736c68]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m9 18 6-6-6-6"/>
                                </svg>
                            </div>
                        </div>

                        <div class="flex items-center justify-between rounded-2xl bg-[#faf7f4] px-4 py-3 ring-1 ring-[#f0e8e2]">
                            <div class="flex items-center gap-3">
                                <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[#d8f1d8] text-[#204d2d]">
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 21s-8.5-4.35-8.5-10.8A4.94 4.94 0 0 1 8.5 6a5.27 5.27 0 0 1 3.5 1.5A5.27 5.27 0 0 1 15.5 6a4.94 4.94 0 0 1 5 4.2C20.5 16.65 12 21 12 21Z"/>
                                    </svg>
                                </div>
                                <div>
                                    <p class="font-semibold text-[#1e1e1e]">Mujeres en acción</p>
                                    <p class="text-xs text-[#7b726d]">27 de junio 2026</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="text-lg font-bold text-[#1d1d1d]">$5.000</span>
                                <svg class="h-5 w-5 text-[#736c68]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m9 18 6-6-6-6"/>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-3 gap-3">
                        <div class="rounded-2xl bg-[#f7f2ed] p-2 ring-1 ring-[#efe5de]">
                            <div class="h-24 rounded-xl bg-gradient-to-br from-[#f3d0a7] via-[#e8c7a4] to-[#cdd9be]"></div>
                            <p class="mt-2 text-center text-[11px] font-medium text-[#544c47]">Alimentación</p>
                        </div>

                        <div class="rounded-2xl bg-[#f7f2ed] p-2 ring-1 ring-[#efe5de]">
                            <div class="h-24 rounded-xl bg-gradient-to-br from-[#d3e7fb] via-[#bedaf5] to-[#f0d2ad]"></div>
                            <p class="mt-2 text-center text-[11px] font-medium text-[#544c47]">Salud</p>
                        </div>

                        <div class="rounded-2xl bg-[#f7f2ed] p-2 ring-1 ring-[#efe5de]">
                            <div class="h-24 rounded-xl bg-gradient-to-br from-[#d8f0d7] via-[#c9e3c4] to-[#f5d8c0]"></div>
                            <p class="mt-2 text-center text-[11px] font-medium text-[#544c47]">Educación</p>
                        </div>
                    </div>
                </div>
            </section>
        </main>
    </div>
</div>
