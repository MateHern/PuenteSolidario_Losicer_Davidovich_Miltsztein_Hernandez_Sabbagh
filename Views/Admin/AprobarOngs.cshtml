@model List<ProgramacionXEfsi_Puente.Models.Organizacion>
@{
    ViewData["Title"] = "Aprobar ONGs";
    var adminNombre = Context.Session.GetString("UsuarioNombre") ?? "Administrador";
    var pendientes = Model?.Count ?? 0;
}

<div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 py-6 md:py-8 lg:grid-cols-[280px_minmax(0,1fr)]">
    <aside class="h-fit rounded-[32px] border border-[#EFE6DD] bg-[#F4EFE9] p-6 shadow-sm">
        <div class="flex flex-col items-center text-center">
            <div class="flex h-24 w-24 items-center justify-center rounded-full bg-[#3F322B] text-3xl font-black text-white shadow-inner">
                @adminNombre.Trim()[0].ToString().ToUpperInvariant()
            </div>
            <p class="mt-5 text-xs font-extrabold uppercase tracking-[0.2em] text-[#FF7341]">Administración</p>
            <h2 class="mt-2 text-2xl font-black text-[#2F2A28]">@adminNombre</h2>
        </div>

        <nav class="mt-8 space-y-3">
            <a href="/Admin/AprobarOngs" class="flex items-center gap-3 rounded-2xl bg-[#F8D7BA] px-4 py-3 text-sm font-black text-[#2F2A28] shadow-sm">
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white/70">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg>
                </span>
                Aprobar ONGs
            </a>
            <a href="/Admin/CrearAdmin" class="flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-bold text-[#534D49] transition hover:bg-white">
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></svg>
                </span>
                Crear administrador
            </a>
            <a href="/Cuenta/Logout" class="flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-bold text-[#534D49] transition hover:bg-white">
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M10 17l5-5-5-5"/><path d="M15 12H3M21 3v18"/></svg>
                </span>
                Cerrar sesión
            </a>
        </nav>
    </aside>

    <main class="space-y-6">
        @if (TempData["AdminCreado"] != null)
        {
            <div class="rounded-2xl border border-[#BFE3D8] bg-[#EAF8F4] px-5 py-4 text-sm font-bold text-[#2F6D5D]">
                @TempData["AdminCreado"]
            </div>
        }

        <section class="overflow-hidden rounded-[32px] border border-[#EEE5DC] bg-white p-6 shadow-sm md:p-8">
            <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
                <div>
                    <p class="text-xs font-extrabold uppercase tracking-[0.22em] text-[#FF7341]">Panel de control</p>
                    <h1 class="mt-3 text-4xl font-black leading-tight text-[#2F2A28] md:text-5xl">Administración de ONGs</h1>
                    <p class="mt-3 max-w-2xl text-base leading-7 text-[#5B4E46]">Revisá las organizaciones que esperan aprobación para formar parte de Puente Solidario.</p>
                </div>

                <div class="min-w-44 rounded-[24px] bg-[#FFF8EA] p-5 text-center ring-1 ring-[#F3E2C9]">
                    <p class="text-4xl font-black text-[#2F2A28]">@pendientes</p>
                    <p class="mt-1 text-sm font-bold text-[#7A6050]">@(pendientes == 1 ? "Solicitud pendiente" : "Solicitudes pendientes")</p>
                </div>
            </div>
        </section>

        <section class="rounded-[32px] border border-[#EEE5DC] bg-white p-5 shadow-sm md:p-7">
            <div class="mb-5 flex items-center justify-between gap-4">
                <div>
                    <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-[#8D7D72]">Solicitudes</p>
                    <h2 class="mt-1 text-2xl font-black text-[#2F2A28]">ONGs por aprobar</h2>
                </div>
            </div>

            @if (Model == null || !Model.Any())
            {
                <div class="rounded-[24px] border border-[#CFE7E3] bg-[#EFF9F7] px-6 py-10 text-center">
                    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-[#62C2B9] text-2xl text-white">✓</div>
                    <h3 class="mt-4 text-xl font-black text-[#2F2A28]">Todo al día</h3>
                    <p class="mt-2 text-sm text-[#5B4E46]">No hay ONGs pendientes de aprobación.</p>
                </div>
            }
            else
            {
                <div class="overflow-hidden rounded-[24px] border border-[#E8DED4]">
                    <div class="hidden grid-cols-[1.2fr_1.4fr_1fr_1.3fr_auto] gap-4 bg-[#F8F5F2] px-5 py-3 text-xs font-extrabold uppercase tracking-[0.12em] text-[#7A6050] md:grid">
                        <span>Nombre</span><span>Email</span><span>Teléfono</span><span>Dirección</span><span>Acción</span>
                    </div>

                    <div class="divide-y divide-[#EEE6DE]">
                        @foreach (var ong in Model)
                        {
                            <div class="grid gap-3 px-5 py-5 md:grid-cols-[1.2fr_1.4fr_1fr_1.3fr_auto] md:items-center">
                                <div><p class="text-xs font-bold uppercase text-[#A09082] md:hidden">Nombre</p><p class="font-black text-[#2F2A28]">@ong.Nombre</p></div>
                                <div><p class="text-xs font-bold uppercase text-[#A09082] md:hidden">Email</p><p class="break-all text-sm text-[#534D49]">@ong.Email</p></div>
                                <div><p class="text-xs font-bold uppercase text-[#A09082] md:hidden">Teléfono</p><p class="text-sm text-[#534D49]">@ong.Telefono</p></div>
                                <div><p class="text-xs font-bold uppercase text-[#A09082] md:hidden">Dirección</p><p class="text-sm text-[#534D49]">@ong.Direccion</p></div>
                                <form asp-action="AprobarOngs" asp-controller="Admin" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@ong.Id" />
                                    <button type="submit" class="w-full rounded-full bg-[#62C2B9] px-5 py-2.5 text-sm font-black text-white shadow-sm transition hover:bg-[#51ACA4] md:w-auto">Aprobar</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            }
        </section>
    </main>
</div>
