@{
    var rol = Context.Session.GetString("Rol");
    var isUsuario = string.Equals(rol, "Usuario", StringComparison.OrdinalIgnoreCase);
    var isOng = string.Equals(rol, "Ong", StringComparison.OrdinalIgnoreCase);
    var isAdmin = string.Equals(rol, "Admin", StringComparison.OrdinalIgnoreCase) || string.Equals(rol, "AdminMadre", StringComparison.OrdinalIgnoreCase);
    var isLoggedIn = !string.IsNullOrWhiteSpace(rol);
    var usuarioNombre = Context.Session.GetString("UsuarioNombre") ?? "Usuario";
    var ongNombre = Context.Session.GetString("OngNombre") ?? "ONG";
    var adminNombre = Context.Session.GetString("UsuarioNombre") ?? "Admin";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Puente Solidario</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        warm: {
                            50: '#FCFBF9',
                            200: '#D8C3A5',
                            700: '#3E3631'
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="min-h-screen bg-[#FCFBF9] text-[#3E3631] antialiased">
    <header class="bg-white shadow-sm">
        <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8">
            <div class="flex items-center gap-2">
                <a href="/" class="text-xl font-bold tracking-tight text-[#3E3631]">Puente Solidario</a>
            </div>

            <div class="hidden items-center gap-8 md:flex">
                <a href="/" class="text-sm font-medium text-[#3E3631] transition hover:text-[#7A695B]">Inicio</a>
                <a href="/Catalogo" class="text-sm font-medium text-[#3E3631] transition hover:text-[#7A695B]">Catálogo</a>

                @if (isUsuario)
                {
                    <a href="/Usuario/Perfil" class="text-sm font-medium text-[#3E3631] transition hover:text-[#7A695B]">Mi Perfil</a>
                }

                @if (isOng)
                {
                    <a href="/Ong/Dashboard" class="text-sm font-medium text-[#3E3631] transition hover:text-[#7A695B]">Panel ONG</a>
                }

                @if (isAdmin)
                {
                    <a href="/Admin/AprobarOngs" class="text-sm font-medium text-[#3E3631] transition hover:text-[#7A695B]">Administración</a>
                }
            </div>

            <div class="flex items-center gap-3">
                @if (!isLoggedIn)
                {
                    <a href="/Cuenta/Login" class="rounded-full bg-[#D8C3A5] px-5 py-2.5 text-sm font-semibold text-[#3E3631] shadow-sm transition hover:bg-[#cbb08e]">
                        Ingresar / Crear cuenta
                    </a>
                }
                else
                {
                    <div class="flex items-center gap-3 rounded-full bg-[#F7F2ED] px-3 py-2 shadow-sm ring-1 ring-[#efe6df]">
                        <div class="flex h-9 w-9 items-center justify-center rounded-full bg-[#3E3631] text-sm font-bold text-white">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM12 14c-4.418 0-8 2.239-8 5v1h16v-1c0-2.761-3.582-5-8-5Z" />
                            </svg>
                        </div>

                        <div class="flex flex-col text-left">
                            <span class="text-xs text-[#6F625D]">Hola</span>
                            <span class="text-sm font-semibold text-[#2F2A28]">@(isUsuario ? usuarioNombre : (isOng ? ongNombre : adminNombre))</span>
                        </div>

                        @if (isUsuario)
                        {
                            <a href="/Usuario/Perfil" class="rounded-full bg-[#D8C3A5] px-3 py-2 text-xs font-semibold text-[#3E3631] transition hover:bg-[#cbb08e]">
                                Mi Perfil
                            </a>
                        }

                        @if (isOng)
                        {
                            <a href="/Ong/Dashboard" class="rounded-full bg-[#D8C3A5] px-3 py-2 text-xs font-semibold text-[#3E3631] transition hover:bg-[#cbb08e]">
                                Panel ONG
                            </a>
                        }

                        @if (isAdmin)
                        {
                            <a href="/Admin/AprobarOngs" class="rounded-full bg-[#D8C3A5] px-3 py-2 text-xs font-semibold text-[#3E3631] transition hover:bg-[#cbb08e]">
                                Administración
                            </a>
                        }

                        <a href="/Cuenta/Logout" class="rounded-full bg-[#3E3631] px-3 py-2 text-xs font-semibold text-white transition hover:bg-[#2d2826]">
                            Cerrar Sesión
                        </a>
                    </div>
                }
            </div>
        </nav>
    </header>

    <main class="min-h-screen bg-[#FCFBF9]">
        <div class="mx-auto max-w-7xl px-6 py-10 lg:px-8">
            @RenderBody()
        </div>
    </main>

    <footer class="bg-[#3E3631] text-[#F2EFEA]">
        <div class="mx-auto flex max-w-7xl flex-col gap-4 px-6 py-8 text-sm md:flex-row md:items-center md:justify-between lg:px-8">
            <p class="font-medium">Puente Solidario · Ayudar nos conecta</p>

            <div class="flex flex-wrap items-center gap-5 text-[#E8E1DB]">
                <a href="#" class="transition hover:text-white">Contacto</a>
                <a href="#" class="transition hover:text-white">Instagram</a>
                <a href="#" class="transition hover:text-white">Privacidad</a>
                <span class="text-[#D9D1CA]">© 2026</span>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
