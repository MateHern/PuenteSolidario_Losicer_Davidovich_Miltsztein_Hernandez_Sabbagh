@{
    var rol = Context.Session.GetString("Rol");
    var isUsuario = string.Equals(rol, "Usuario", StringComparison.OrdinalIgnoreCase);
    var isOng = string.Equals(rol, "Ong", StringComparison.OrdinalIgnoreCase);
    var isAdmin = string.Equals(rol, "Admin", StringComparison.OrdinalIgnoreCase);
    var isLoggedIn = !string.IsNullOrWhiteSpace(rol);
    var usuarioNombre = Context.Session.GetString("UsuarioNombre") ?? "Usuario";
    var ongNombre = Context.Session.GetString("OngNombre") ?? "ONG";
    var adminNombre = Context.Session.GetString("UsuarioNombre") ?? "Admin";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Puente Solidario</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Poppins:wght@600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        warm: {
                            50: '#F5F3EF',
                            200: '#FFEF87',
                            700: '#3F322B'
                        }
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-[#F5F3EF] text-[#3F322B] antialiased">
    <header class="sticky top-0 z-50 border-b border-[#EADBCD] bg-[#FFFDFB]/90 backdrop-blur-sm shadow-sm">
        <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
            <div class="flex items-center gap-2">
                <a href="/" class="text-xl font-black tracking-[-0.04em] text-[#3F322B]">Puente Solidario</a>
            </div>

            <div class="hidden items-center gap-8 md:flex">
                <a href="/" class="text-sm font-bold text-[#3F322B] transition hover:text-[#FF7341]">Inicio</a>
                <a href="/Catalogo" class="text-sm font-bold text-[#3F322B] transition hover:text-[#FF7341]">Catálogo</a>

                @if (isUsuario)
                {
                    <a href="/Usuario/Perfil" class="text-sm font-bold text-[#3F322B] transition hover:text-[#FF7341]">Mi Perfil</a>
                }

                @if (isOng)
                {
                    <a href="/Ong/Dashboard" class="text-sm font-bold text-[#3F322B] transition hover:text-[#FF7341]">Panel ONG</a>
                }

                @if (isAdmin)
                {
                    <a href="/Admin/AprobarOngs" class="text-sm font-bold text-[#3F322B] transition hover:text-[#FF7341]">Administración</a>
                }
            </div>

            <div class="flex items-center gap-3">
                <button type="button" class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-[#E7D7C8] bg-white text-[#3F322B] shadow-sm md:hidden" data-nav-toggle aria-expanded="false" aria-label="Abrir menú">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16"/>
                    </svg>
                </button>

                @if (!isLoggedIn)
                {
                    <a href="/Cuenta/Login" class="hidden rounded-full bg-[#FF7341] px-5 py-2.5 text-sm font-black text-white shadow-sm transition hover:bg-[#EA6235] sm:inline-flex">
                        Ingresar / Crear cuenta
                    </a>
                }
                else
                {
                    <div class="hidden items-center gap-3 rounded-full bg-[#F7F2ED] px-3 py-2 shadow-sm ring-1 ring-[#efe6df] md:flex">
                        <div class="flex h-9 w-9 items-center justify-center rounded-full bg-[#3F322B] text-sm font-bold text-white">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM12 14c-4.418 0-8 2.239-8 5v1h16v-1c0-2.761-3.582-5-8-5Z" />
                            </svg>
                        </div>

                        <div class="flex flex-col text-left">
                            <span class="text-[11px] uppercase tracking-[0.18em] text-[#6F625D]">Hola</span>
                            <span class="text-sm font-extrabold text-[#3F322B]">@(isUsuario ? usuarioNombre : (isOng ? ongNombre : adminNombre))</span>
                        </div>

                        @if (isUsuario)
                        {
                            <a href="/Usuario/Perfil" class="rounded-full bg-[#FF7341] px-3 py-2 text-xs font-black text-white transition hover:bg-[#EA6235]">
                                Mi Perfil
                            </a>
                        }

                        @if (isOng)
                        {
                            <a href="/Ong/Dashboard" class="rounded-full bg-[#FF7341] px-3 py-2 text-xs font-black text-white transition hover:bg-[#EA6235]">
                                Panel ONG
                            </a>
                        }

                        @if (isAdmin)
                        {
                            <a href="/Admin/AprobarOngs" class="rounded-full bg-[#FF7341] px-3 py-2 text-xs font-black text-white transition hover:bg-[#EA6235]">
                                Administración
                            </a>
                        }

                        <a href="/Cuenta/Logout" class="rounded-full bg-[#3F322B] px-3 py-2 text-xs font-black text-white transition hover:bg-[#291f1c]">
                            Cerrar Sesión
                        </a>
                    </div>
                }
            </div>
        </nav>

        <div class="mx-auto hidden max-w-7xl px-4 pb-4 md:hidden" data-mobile-nav>
            <div class="space-y-2 rounded-2xl border border-[#E9DED2] bg-[#F9F5F1] p-3 shadow-sm">
                <a href="/" class="block rounded-xl px-3 py-2 text-sm font-bold text-[#3F322B] hover:bg-white">Inicio</a>
                <a href="/Catalogo" class="block rounded-xl px-3 py-2 text-sm font-bold text-[#3F322B] hover:bg-white">Catálogo</a>
                @if (isUsuario)
                {
                    <a href="/Usuario/Perfil" class="block rounded-xl px-3 py-2 text-sm font-bold text-[#3F322B] hover:bg-white">Mi Perfil</a>
                }
                @if (isOng)
                {
                    <a href="/Ong/Dashboard" class="block rounded-xl px-3 py-2 text-sm font-bold text-[#3F322B] hover:bg-white">Panel ONG</a>
                }
                @if (isAdmin)
                {
                    <a href="/Admin/AprobarOngs" class="block rounded-xl px-3 py-2 text-sm font-bold text-[#3F322B] hover:bg-white">Administración</a>
                }
                @if (!isLoggedIn)
                {
                    <a href="/Cuenta/Login" class="mt-2 block rounded-xl bg-[#FF7341] px-3 py-2 text-sm font-black text-white text-center">Ingresar / Crear cuenta</a>
                }
                else
                {
                    <a href="/Cuenta/Logout" class="mt-2 block rounded-xl bg-[#3F322B] px-3 py-2 text-sm font-black text-white text-center">Cerrar sesión</a>
                }
            </div>
        </div>
    </header>

    <main class="min-h-[calc(100vh-180px)] bg-[#F5F3EF]">
        <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
            @RenderBody()
        </div>
    </main>

    <footer class="bg-[#3F322B] text-[#F2EFEA]">
        <div class="mx-auto flex max-w-7xl flex-col gap-4 px-4 py-8 text-sm md:flex-row md:items-center md:justify-between sm:px-6 lg:px-8">
            <p class="font-semibold">Puente Solidario · Ayudar nos conecta</p>

            <div class="flex flex-wrap items-center gap-5 text-[#E7DED5]">
                <a href="#" class="transition hover:text-white">Contacto</a>
                <a href="#" class="transition hover:text-white">Instagram</a>
                <a href="#" class="transition hover:text-white">Privacidad</a>
                <span class="text-[#D5C8BE]">© <span data-current-year></span></span>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
